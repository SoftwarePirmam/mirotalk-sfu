# ============================================================
# MiroTalk SFU — Coolify production environment template
# Copy to .env (or paste into Coolify → Environment Variables)
# Never commit real secrets.
# ============================================================

# --- Core URL / listen (Coolify Traefik terminates TLS) ---
# Public URL shown to users (must match your Coolify domain + HTTPS)
SERVER_HOST_URL=https://meet.example.com

# Bind address and internal HTTP port (Traefik → container:8080)
SERVER_LISTEN_IP=0.0.0.0
SERVER_LISTEN_PORT=8080

# Trust X-Forwarded-* from Coolify Traefik (required in production)
TRUST_PROXY=true

NODE_ENV=production

# --- WebRTC / mediasoup ---
# Public IPv4 of the Coolify host (NOT 172.x / 10.x / 192.168.x)
SFU_ANNOUNCED_IP=203.0.113.10
SFU_LISTEN_IP=0.0.0.0
# Must match published ports in docker-compose.yml
SFU_MIN_PORT=40000
SFU_MAX_PORT=40100
# Optional: CPU workers (empty = auto). SFU_SERVER=true = one UDP port per worker
SFU_NUM_WORKERS=
SFU_SERVER=false

# --- Secrets (generate strong values) ---
# openssl rand -hex 32
JWT_SECRET=CHANGE_ME_USE_openssl_rand_hex_32
# API authentication secret (change the default)
API_KEY_SECRET=CHANGE_ME_strong_api_secret

# --- Host protection (room host login) ---
# MiroTalk env name is HOST_PROTECTED (aka “host protection enabled”)
HOST_PROTECTED=false
HOST_USER_AUTH=false
# Required when HOST_PROTECTED or HOST_USER_AUTH is true:
# format: user:password:DisplayName:allowedRooms|user2:...
# HOST_USERS=alice:StrongPassHere:Alice:*

# --- Optional hardening ---
CORS_ORIGIN=*
# CORS_ORIGIN=https://meet.example.com
